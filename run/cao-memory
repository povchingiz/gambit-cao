#!/usr/bin/env python3
"""cao-memory — CLI interface for SQLite FTS5 Episodic Memory Layer.

Usage:
  cao-memory query <terms> [--category <cat>] [--limit <N>] [--fleet]
  cao-memory store --category <cat> --summary <sum> [--details <det>] [--files <f>] [--session <id>] [--fleet]
  cao-memory list [--limit <N>] [--fleet]
  cao-memory prune [--days 30] [--keep-min 50] [--fleet]
  cao-memory vacuum [--fleet]
"""
import argparse
import sys
from pathlib import Path

# Add repo root to sys.path
HERE = Path(__file__).resolve().parent
REPO = HERE.parent
if str(REPO) not in sys.path:
    sys.path.insert(0, str(REPO))

from run.cao_memory import (
    store_memory,
    query_memory,
    list_memories,
    prune_memories,
    vacuum_memory,
)


def main():
    parser = argparse.ArgumentParser(description="CAO Episodic Memory CLI (SQLite FTS5)")
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    # query / recall
    p_query = subparsers.add_parser("query", aliases=["recall"], help="Search memories by keyword using FTS5")
    p_query.add_argument("query", help="Search query string")
    p_query.add_argument("--category", "-c", help="Filter by category")
    p_query.add_argument("--limit", "-n", type=int, default=10, help="Maximum results (default: 10)")
    p_query.add_argument("--fleet", action="store_true", help="Search global fleet memory (~/.cao/fleet_memory.sqlite)")

    # store
    p_store = subparsers.add_parser("store", help="Store a memory entry")
    p_store.add_argument("--category", "-c", required=True, help="Category (e.g. bug_fix, architecture, preference)")
    p_store.add_argument("--summary", "-s", required=True, help="Short summary")
    p_store.add_argument("--details", "-d", default="", help="Detailed memory or solution context")
    p_store.add_argument("--files", "-f", default="", help="Associated file paths")
    p_store.add_argument("--session", default="manual", help="Session ID")
    p_store.add_argument("--fleet", action="store_true", help="Store into global fleet memory (~/.cao/fleet_memory.sqlite)")

    # list
    p_list = subparsers.add_parser("list", help="List recent memories")
    p_list.add_argument("--limit", "-n", type=int, default=15, help="Maximum entries to list")
    p_list.add_argument("--fleet", action="store_true", help="List from global fleet memory (~/.cao/fleet_memory.sqlite)")

    # prune
    p_prune = subparsers.add_parser("prune", help="Prune old memories while keeping a minimum number of recent entries")
    p_prune.add_argument("--days", type=int, default=30, help="Max age in days before pruning (default: 30)")
    p_prune.add_argument("--keep-min", type=int, default=50, help="Minimum recent entries to retain (default: 50)")
    p_prune.add_argument("--fleet", action="store_true", help="Prune global fleet memory (~/.cao/fleet_memory.sqlite)")

    # vacuum
    p_vacuum = subparsers.add_parser("vacuum", help="Optimize FTS5 index and vacuum SQLite database")
    p_vacuum.add_argument("--fleet", action="store_true", help="Vacuum global fleet memory (~/.cao/fleet_memory.sqlite)")

    args = parser.parse_args()

    if args.subcommand in ("query", "recall"):
        results = query_memory(args.query, category=args.category, limit=args.limit, fleet=args.fleet)
        if not results:
            target_desc = "fleet memory (~/.cao/fleet_memory.sqlite)" if args.fleet else "wcao/memory.sqlite"
            print(f"No memories matched '{args.query}' in {target_desc}.")
            return
        print(f"Found {len(results)} memory match(es):")
        for r in results:
            print(f"\n[{r['category']}] {r['summary']} ({r['created_at'][:19]})")
            if r['details']:
                print(f"  Details: {r['details']}")
            if r['file_paths']:
                print(f"  Files: {r['file_paths']}")

    elif args.subcommand == "store":
        rowid = store_memory(
            category=args.category,
            summary=args.summary,
            details=args.details,
            file_paths=args.files,
            session_id=args.session,
            fleet=args.fleet,
        )
        target_desc = "~/.cao/fleet_memory.sqlite" if args.fleet else "wcao/memory.sqlite"
        print(f"✓ Stored memory entry #{rowid} in {target_desc}")

    elif args.subcommand == "list":
        results = list_memories(limit=args.limit, fleet=args.fleet)
        if not results:
            target_desc = "fleet memory" if args.fleet else "wcao/memory.sqlite"
            print(f"No memories recorded yet in {target_desc}.")
            return
        print(f"Recent {len(results)} memory entry(ies):")
        for r in results:
            print(f"- [#{r['rowid']} | {r['category']}] {r['summary']} ({r['created_at'][:19]})")

    elif args.subcommand == "prune":
        pruned = prune_memories(max_age_days=args.days, keep_min=args.keep_min, fleet=args.fleet)
        target_desc = "~/.cao/fleet_memory.sqlite" if args.fleet else "wcao/memory.sqlite"
        print(f"✓ Pruned {pruned} memory entry(ies) from {target_desc} (days>{args.days}, keep_min={args.keep_min})")

    elif args.subcommand == "vacuum":
        vacuum_memory(fleet=args.fleet)
        target_desc = "~/.cao/fleet_memory.sqlite" if args.fleet else "wcao/memory.sqlite"
        print(f"✓ Vacuumed and optimized {target_desc}")


if __name__ == "__main__":
    main()
