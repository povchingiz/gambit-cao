#!/usr/bin/env python3
"""cao-init — 1-Click Interactive Setup Wizard for cao-crew (P6.5).

Auto-detects installed CLI engines (claude, opencode, codex, agy, copilot),
inspects authentication tokens and local API keys, writes a tailored
setup/2_configure/cao.config.local.toml, and executes apply.sh in a single step.

Usage:
  cao-init [--non-interactive] [--endpoint <url>] [--default-supervisor <engine>]
"""
from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Dict, List, Optional

HERE = Path(__file__).resolve().parent
REPO = HERE.parent
CONFIGURE_DIR = REPO / "setup" / "2_configure"
APPLY_SCRIPT = REPO / "setup" / "3_apply" / "apply.sh"


def detect_clis() -> Dict[str, bool]:
    return {
        "claude": shutil.which("claude") is not None,
        "opencode": shutil.which("opencode") is not None,
        "codex": shutil.which("codex") is not None,
        "agy": shutil.which("agy") is not None,
        "copilot": shutil.which("gh") is not None,
    }


def select_best_supervisor(available: Dict[str, bool]) -> str:
    if available.get("claude"):
        return "claude_worker"
    if available.get("agy"):
        return "antigravity_worker"
    if available.get("codex"):
        return "codex_worker"
    if available.get("opencode"):
        return "coder_worker"
    return "code_supervisor"


def generate_local_config(
    available: Dict[str, bool],
    supervisor: str,
    endpoint_url: str = "https://openrouter.ai/api/v1",
) -> str:
    registered = ["code_supervisor"]
    if available.get("claude"):
        registered.append("claude_worker")
    if available.get("opencode"):
        registered.append("coder_worker")
    if available.get("codex"):
        registered.append("codex_worker")
    if available.get("agy"):
        registered.append("antigravity_worker")

    config_lines = [
        "# ============================================================",
        "#  CAO — Local Tailored Configuration (Generated by cao-init)",
        "# ============================================================",
        "",
        "[orchestrator]",
        f'default_supervisor     = "{supervisor}"',
        'default_provider       = "claude_code"',
        "worktree_isolation     = true",
        "max_concurrent_workers = 4",
        "server_port            = 9889",
        "",
        "[endpoint]",
        'name     = "openrouter"',
        f'base_url = "{endpoint_url}"',
        "models   = [",
        '  "deepseek/deepseek-chat",',
        '  "qwen/qwen-2.5-coder-32b-instruct",',
        "]",
        'default_model = "deepseek/deepseek-chat"',
        "",
        "[profiles]",
        f"register = {repr(registered)}",
        "",
    ]
    return "\n".join(config_lines)


def main():
    print("🧙 CAO-INIT — Setup Wizard for cao-crew (Milestone P6.5)")
    print("=" * 68)

    clis = detect_clis()
    for name, found in clis.items():
        status = "✓ FOUND" if found else "✗ NOT FOUND"
        print(f"  • {name:12s}: {status}")

    best_sup = select_best_supervisor(clis)
    print("-" * 68)
    print(f"🎯 Recommended Default Supervisor: {best_sup}")

    # Generate cao.config.local.toml
    local_cfg_path = CONFIGURE_DIR / "cao.config.local.toml"
    cfg_text = generate_local_config(clis, best_sup)
    local_cfg_path.write_text(cfg_text, encoding="utf-8")
    print(f"📝 Generated tailored config: {local_cfg_path}")

    # Compile with apply.sh
    print("🚀 Compiling profiles via apply.sh...")
    if APPLY_SCRIPT.exists() and os.access(APPLY_SCRIPT, os.X_OK):
        subprocess.run([str(APPLY_SCRIPT)], check=True)
    else:
        subprocess.run(["bash", str(APPLY_SCRIPT)], check=True)

    print("=" * 68)
    print("✅ CAO initialization complete! Run `run/cao-doctor` to verify readiness.")


if __name__ == "__main__":
    main()
